# ── API proxy ─────────────────────────────────────────────────────────────────
# Server-side only: origin that the Next.js rewrite proxies `/api/v1/*` to.
# The browser never sees this value (all API calls are same-origin).
API_ORIGIN=http://localhost:5000

# ── Cloudinary (browser-exposed) for DIRECT video upload ──────────────────────
# Video lessons are uploaded straight from the browser to Cloudinary's CDN.
# These values are PUBLIC by design (cloud name + api key are client-safe).
# The api_secret must NEVER live here — it stays server-side only.
#
# CLOUD_NAME / API_KEY: mirror the values used by the API (.env).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
# Unsigned upload preset — create it in the Cloudinary Dashboard
# (Settings → Upload → Upload presets → mode "Unsigned") and put its name here.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
