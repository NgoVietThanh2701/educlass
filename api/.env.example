# ============================================================
# EduClass API — production environment template
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=production
# Number of proxy hops to trust when behind a reverse proxy (0 = direct).
# Required for correct rate-limits / real client IPs behind nginx/LB.
TRUST_PROXY=1

# --- Database (Postgres / Neon) ---
# Prisma connects on boot; a keep-alive `SELECT 1` runs every 60s to avoid
# serverless cold-starts that would otherwise break Socket.IO auth handshakes.
DATABASE_URL=postgresql://user:pass@host:5432/educlass?sslmode=require

# --- Auth / JWT ---
JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=3600
JWT_REFRESH_SECRET=change-me-other-long-random-string
JWT_REFRESH_EXPIRES_IN=90000

# --- Admin bootstrap ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# --- Redis (rate-limit / sessions) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# --- OTP ---
OTP_TTL=300
OTP_RATE_LIMIT=600

# --- Mail (SMTP) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=no-reply@example.com
MAIL_PASSWORD=replace-me
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="EduClass"
MAIL_SUPPORT=support@example.com

# --- App / CORS ---
# Web origin (used as REST CORS fallback).
APP_URL=https://app.example.com
# Comma-separated allowed origins used for BOTH REST CORS and the Socket.IO
# gateway (the web app connects the chat socket cross-origin to
# NEXT_PUBLIC_SOCKET_URL, so this must include the web origin) — MUST include
# APP_URL.
ALLOWED_ORIGINS=https://app.example.com

# --- Swagger / docs ---
# Serve /api/docs in production only if you explicitly want it.
SWAGGER_ENABLED=false

# --- Cloudinary (upload) ---
CLOUDINARY_CLOUD_NAME=xxxxx
CLOUDINARY_API_KEY=xxxxx
CLOUDINARY_API_SECRET=xxxxx
CDN_BASE_URL=https://res.cloudinary.com/xxxxx

# --- Google OAuth ---
# Client ID/Secret from Google Cloud Console (OAuth 2.0 Client, "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Web-origin callback (goes through the Next.js proxy so the httpOnly refresh
# cookie lands on the web host). Must match Google Console redirect URIs.
GOOGLE_CALLBACK_URL=https://app.example.com/api/v1/auth/google/callback