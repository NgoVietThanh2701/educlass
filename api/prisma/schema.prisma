// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  //output   = "../src/generated/prisma"
}

// generator dbml {
//   provider = "prisma-dbml-generator"
//    output   = "./dbml"
// }

datasource db {
  provider = "postgresql"
}

/**
 * ------------------ Define model ----------
 */

enum RoleManager {
  ADMIN
  MANAGER
}

model Manager {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  role         RoleManager
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("managers")
}

// ==================== ENUMS ====================
enum RoleUser {
  STUDENT
  TEACHER
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL
}

enum LessonType {
  VIDEO
  TEXT
}

enum LessonUnlockRule {
  FREE
  PREVIOUS_LESSON
  PREVIOUS_ASSESSMENT
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
}

enum QuestionType {
  SINGLE
  MULTIPLE
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  TIMEOUT
}

enum ConversationType {
  DIRECT
  GROUP
}

enum GroupMessagePermission {
  ALL
  TEACHER_ONLY
}

// ==================== USER ====================
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  userName      String    @unique
  fullName      String
  passwordHash  String
  balance       Decimal   @default(0) @db.Decimal(10, 2)
  role          RoleUser  @default(STUDENT)
  refreshToken  String?
  emailVerified Boolean   @default(false)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ownedCourses       Course[]
  enrollments        Enrollment[]
  assessmentAttempts AssessmentAttempt[]
  lessonProgress     LessonProgress[]
  conversations      Participant[]
  sentMessages       Message[]

  @@index([role])
  @@index([fullName])
  @@map("users")
}

// ==================== COURSE ====================
model Course {
  id                   String       @id @default(uuid())
  teacherId            String
  title                String
  slug                 String       @unique
  shortDescription     String?
  description          String?
  thumbnailObjectKey   String
  level               CourseLevel  @default(ALL)
  language          String       @default("vi")
  category          String?
  price             Decimal      @default(0) @db.Decimal(10, 2)
  status            CourseStatus @default(DRAFT)
  publishedAt       DateTime?
  estimatedDuration Int?
  requirements      String?
  learningOutcomes  String?
  archivedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  teacher      User          @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  sections     Section[]
  enrollments  Enrollment[]
  conversation Conversation?

  @@index([teacherId])
  @@index([slug])
  @@index([status])
  @@index([teacherId, status])
  @@map("courses")
}

// ==================== SECTION ====================
model Section {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  assessments Assessment[]

  @@unique([courseId, order])
  @@map("sections")
}

// ==================== LESSON ====================
model Lesson {
  id              String           @id @default(uuid())
  sectionId       String
  title           String
  description     String?
  type            LessonType
  order           Int
  durationSeconds Int?
  isPreview       Boolean          @default(false)
  unlockRule      LessonUnlockRule @default(FREE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  section     Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  content     LessonContent?
  attachments LessonAttachment[]
  progress    LessonProgress[]

  @@unique([sectionId, order])
  @@map("lessons")
}

model LessonContent {
  lessonId      String  @id
  objectKey     String?
  videoDuration Int?
  textContent   String?

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_contents")
}

model LessonAttachment {
  id           String   @id @default(uuid())
  lessonId     String
  fileName     String
  objectKey    String
  resourceType String
  size         Int
  mimeType     String
  createdAt    DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_attachments")
}

// ==================== LESSON PROGRESS ====================
model LessonProgress {
  id           String    @id @default(uuid())
  userId       String
  lessonId     String
  completed    Boolean   @default(false)
  lastPosition Int       @default(0)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, completed])
  @@index([lessonId, completed])
  @@map("lesson_progress")
}

// ==================== ASSESSMENT ====================
model Assessment {
  id               String           @id @default(uuid())
  sectionId        String
  title            String
  description      String?
  order            Int
  duration         Int
  passingScore     Decimal          @default(50) @db.Decimal(5, 2)
  maxAttempts      Int?
  shuffleQuestions Boolean          @default(false)
  shuffleOptions   Boolean          @default(false)
  status           AssessmentStatus @default(DRAFT)
  archivedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  section   Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]

  @@unique([sectionId, order])
  @@index([sectionId])
  @@index([status])
  @@map("assessments")
}

model AssessmentQuestion {
  id           String       @id @default(uuid())
  assessmentId String
  content      String
  explanation  String?
  score        Decimal      @default(1) @db.Decimal(5, 2)
  order        Int
  type         QuestionType @default(SINGLE)

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options    AssessmentOption[]

  @@unique([assessmentId, order])
  @@index([assessmentId])
  @@map("assessment_questions")
}

model AssessmentOption {
  id         String  @id @default(uuid())
  questionId String
  content    String
  isCorrect  Boolean
  order      Int

  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  StudentAnswer[]

  @@unique([questionId, order])
  @@unique([id, questionId])
  @@index([questionId])
  @@map("assessment_options")
}

// ==================== ASSESSMENT ATTEMPT ====================
model AssessmentAttempt {
  id            String        @id @default(uuid())
  assessmentId  String
  studentId     String
  attemptNumber Int           @default(1)
  startedAt     DateTime      @default(now())
  finishedAt    DateTime?
  score         Decimal?      @db.Decimal(5, 2)
  passed        Boolean?
  status        AttemptStatus @default(IN_PROGRESS)

  assessment Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers    StudentAnswer[]

  @@unique([assessmentId, studentId, attemptNumber])
  @@index([assessmentId])
  @@index([studentId])
  @@index([studentId, status])
  @@index([assessmentId, status])
  @@map("assessment_attempts")
}

model StudentAnswer {
  attemptId String
  optionId  String

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  option  AssessmentOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([attemptId, optionId])
  @@index([optionId])
  @@map("student_answers")
}

// ==================== ENROLLMENT ====================
model Enrollment {
  courseId    String
  studentId   String
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  joinedAt    DateTime         @default(now())

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([courseId, studentId])
  @@index([studentId])
  @@index([courseId, status])
  @@index([status])
  @@map("enrollments")
}

// ==================== CHAT ====================
model Conversation {
  id                String                  @id @default(uuid())
  type              ConversationType
  courseId          String?                 @unique
  course            Course?                 @relation(fields: [courseId], references: [id])
  messagePermission GroupMessagePermission?
  participants      Participant[]
  messages          Message[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([courseId])
}

model Participant {
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String?
  createdAt      DateTime @default(now())

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderId], references: [id])
  attachments  MessageAttachment[]

  @@index([senderId])
  @@index([conversationId, createdAt])
}

model MessageAttachment {
  id           String @id @default(uuid())
  messageId    String
  objectKey    String
  resourceType String
  filename     String
  size         Int
  mimeType     String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}
