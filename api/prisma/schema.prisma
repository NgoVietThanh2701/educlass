// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  //output   = "../src/generated/prisma"
}

generator dbml {
  provider = "prisma-dbml-generator"
   output   = "./dbml"
}

datasource db {
  provider = "postgresql"
}

/* ------------------ Define model ---------- */

enum RoleManager {
  ADMIN
  MANAGER
}

model Manager {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  role          RoleManager
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("managers")
}

enum RoleUser {
  STUDENT
  TEACHER
}

// user of app
model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  userName      String    @unique
  fullName      String
  passwordHash  String
  balance       Decimal   @default(0) @db.Decimal(10, 2)
  role          RoleUser  @default(TEACHER)
  refreshToken  String? // hash refresh token
  studentNo     Int?      @unique
  teacherNo     Int?      @unique
  mustChangePassword Boolean @default(false)
  emailVerified Boolean @default(false)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

   // teacher owned many class
  ownedClasses Class[] @relation("TeacherClasses")
  ownedExams Exam[] @relation("TeacherExams")
  examAttempts ExamAttempt[]
  classStudents ClassStudent[] @relation("StudentEnrollments")

  @@index([role])
  @@index([fullName])
  @@index([createdAt])
  @@index([refreshToken])
  @@map("users") // the name of the table
}

// class 
model Class {
  id          String   @id @default(uuid())
  name        String
  code        String @unique
  description String?
  teacherId   String
  archivedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // class belong to one teacher
  teacher User @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Restrict)
  classStudents ClassStudent[] @relation("StudentEnrollments")
  exams ExamSession[]

  @@index([teacherId])
  @@map("classes")
}

// description student belong to class
model ClassStudent  {
  classId   String
  studentId String
  joinedAt DateTime @default(now())

  class Class @relation("StudentEnrollments", fields: [classId], references: [id], onDelete: Cascade)
  student User @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@id([classId, studentId])// check class and student is unique. not exists in class with two student
  @@map("class_students")
}

// model for exam
enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Exam {
  id          String   @id @default(uuid())
  title       String
  description String?
  teacherId   String
  duration    Int // phút
  status      ExamStatus @default(DRAFT)
  shuffleQuestions Boolean @default(false)
  shuffleOptions   Boolean @default(false)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher User @relation("TeacherExams", fields: [teacherId], references: [id], onDelete: Restrict)
  questions ExamQuestion[]
  classes ExamSession[]

  @@index([teacherId])
  @@map("exams")
}

enum QuestionType {
  SINGLE
  MULTIPLE
}

// question of exam
model ExamQuestion {
  id String @id @default(uuid())
  examId String
  content String
  explanation String?
  score Decimal @default(1) @db.Decimal(5,2)
  order Int
  type QuestionType @default(SINGLE)

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  options QuestionOption[]
  studentAnswers StudentAnswer[]

  @@index([examId])
  @@unique([examId, order])
  @@map("exam_questions")
}

model QuestionOption {
  id String @id @default(uuid())
  questionId String
  content String
  isCorrect Boolean
  order Int

  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentAnswers StudentAnswer[]

  @@index([questionId])
  @@unique([questionId, order])
  @@unique([id, questionId])
  @@map("question_options")
}

enum ExamSessionStatus {
  SCHEDULED
  OPEN
  CLOSED
}

model ExamSession  {
  id String @id @default(uuid())
  examId String
  classId String
  name String?
  startAt DateTime
  // Extra minutes after exam duration before session closes
  sessionDelayMinutes Int @default(0)
  status ExamSessionStatus @default(SCHEDULED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Restrict)
  class Class @relation(fields: [classId], references: [id], onDelete: Restrict)
  attempts ExamAttempt[]

  @@index([classId])
  @@index([examId])
  @@index([status])
  @@index([startAt])
  @@unique([examId, classId, startAt])
  @@map("exam_sessions")
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  TIMEOUT
}

model ExamAttempt {
  id String @id @default(uuid())
  sessionId String
  studentId String
  startedAt DateTime @default(now())
  finishedAt DateTime?
  deadlineAt DateTime
  score Decimal? @db.Decimal(5,2)
  status AttemptStatus @default(IN_PROGRESS)

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User @relation(fields:[studentId], references:[id], onDelete: Cascade)
  answers StudentAnswer[]

  @@index([sessionId])
  @@index([studentId])
  @@index([status])
  @@index([sessionId, studentId])
  @@unique([sessionId, studentId])
  @@map("exam_attempts")
}

model StudentAnswer {
  attemptId String
  questionId String
  optionId String

  attempt ExamAttempt @relation(fields:[attemptId], references:[id], onDelete: Cascade)
  question ExamQuestion @relation(fields:[questionId], references:[id], onDelete: Cascade)
  option QuestionOption @relation(fields:[optionId, questionId], references:[id, questionId])

  @@id([attemptId, questionId, optionId])
  @@index([questionId])
  @@map("student_answers")
}
