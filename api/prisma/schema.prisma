// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  //output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/* ------------------ Define model ---------- */

enum RoleUser {
  STUDENT
  TEACHER
}

enum RoleManager {
  ADMIN
  MANAGER
}

enum PurposeOTP {
  REGISTER
  RESET_PASSWORD
  CHANGE_EMAIL
}

model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  userName      String    @unique
  fullName      String
  passwordHash  String
  balance       Decimal   @default(0) @db.Decimal(10, 2)
  role          RoleUser  @default(TEACHER)
  refreshToken  String? // hash refresh token
  studentNo     Int?      @unique
  teacherNo     Int?      @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([role])
  @@index([fullName])
  @@map("users") // the name of the table
}

model Manager {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  role          RoleManager
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("managers")
}

model EmailVerification {
  id String @id @default(uuid())
  email String
  code String
  purpose PurposeOTP
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, purpose])
  @@map("email_verifications")
}
